{
  "name": "voice-daw",
  "version": "1.0.0",
  "description": "声を録音して楽器にし、GarageBand風に作曲してMP3で書き出せるスマホ向け作曲アプリ（Android APK / Capacitor）",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node scripts/selftest.mjs",
    "build": "node scripts/build.mjs",
    "sync": "node scripts/build.mjs && cap sync android",
    "apk": "node scripts/build.mjs && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "latest-7",
    "@capacitor/share": "latest-7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10"
  }
}
